# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
*.egg

# --- Environnements virtuels ---
.venv/
venv/
env/

# --- Outils de developpement et de test ---
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# --- Donnees et sorties de production ---
data/
store/
resultats/
*.parquet
*.duckdb
*.db

# Les frontieres vendues par le frontend sont une source versionnee, pas une
# sortie de production : elles doivent etre suivies. `data/` ci-dessus ignore
# tout repertoire nomme `data`, a toute profondeur ; ces deux-la sont
# explicitement re-inclus. Un repertoire ignore ne peut pas contenir de
# fichier re-inclus : il faut donc re-inclure le repertoire lui-meme.
!frontend/public/data/
!src/torne/explorer/static/data/

# --- Secrets ---
.env
.env.*
!.env.example

# --- Editeurs et systeme ---
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- Verrou de dependances ---
# uv.lock est VOLONTAIREMENT versionne : c'est lui qui rend l'environnement reproductible.
# Ne pas ajouter cette ligne au fichier .gitignore.
