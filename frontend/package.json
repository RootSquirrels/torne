{
  "name": "torne-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TORNE frontend — a compiled static application served by FastAPI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/bundle-report.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "bundle:report": "node scripts/bundle-report.mjs",
    "generate:types": "node scripts/generate-types.mjs",
    "check:types": "node scripts/generate-types.mjs --check",
    "build:boundaries": "node scripts/build-boundaries.mjs",
    "prebuild": "npm run build:boundaries",
    "predev": "npm run build:boundaries"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "topojson-client": "^3.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "world-atlas": "^2.0.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
